# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_VISION_DETAIL=auto
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_TRANSLATE_MODEL=gpt-realtime-translate
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-realtime-whisper
OPENAI_REALTIME_VOICE=coral
OPENAI_REALTIME_TRANSLATION_LANGUAGE=en
OPENAI_MAX_OUTPUT_TOKENS=420
OPENAI_WORK_MAX_OUTPUT_TOKENS=2200
OPENAI_VISION_MAX_OUTPUT_TOKENS=1200
OPENAI_WEB_SEARCH_ENABLED=true
OPENAI_WEB_SEARCH_MODE=auto
OPENAI_WEB_SEARCH_CONTEXT_SIZE=low
OPENAI_WEB_SEARCH_COUNTRY=JP
OPENAI_WEB_SEARCH_CITY=
OPENAI_WEB_SEARCH_REGION=
OPENAI_WEB_SEARCH_TIMEZONE=Asia/Tokyo

# Google Gemini
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash-lite

# Grok / xAI
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_CHAT_MODEL=grok-4.3

# Local services
VOICEVOX_BASE_URL=http://127.0.0.1:50021
VOICEVOX_CPU_THREADS=0
VOICEVOX_ENABLE_CANCELLABLE_SYNTHESIS=1
VOICEVOX_LOAD_ALL_MODELS=0
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_CHAT_MODEL=local-model

# Optional structured external-information APIs
# Open-Meteo does not require an API key.
OPEN_METEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1
OPEN_METEO_FORECAST_BASE_URL=https://api.open-meteo.com/v1

# Optional external HTTP TTS adapter
# Set TTS_PROVIDER=http and point these values at a compatible TTS service.
# Irodori TTS or future cloud/local TTS services can be tested through this adapter
# when they expose a JSON-in/audio-out HTTP endpoint.
HTTP_TTS_BASE_URL=
HTTP_TTS_ENDPOINT=/tts
HTTP_TTS_API_KEY=
HTTP_TTS_HEALTH_ENDPOINT=
HTTP_TTS_PROVIDER_ID=
HTTP_TTS_PAYLOAD_FORMAT=generic
HTTP_TTS_VOICE=
HTTP_TTS_MODEL=
HTTP_TTS_GENDER=
HTTP_TTS_INSTRUCT=
HTTP_TTS_LANG_CODE=
HTTP_TTS_FORMAT=wav
HTTP_TTS_AUDIO_PROCESSOR=auto
HTTP_TTS_SOUNDSTRETCH_PATH=
HTTP_TTS_IRODORI_NUM_STEPS=0
HTTP_TTS_IRODORI_SEED=0
HTTP_TTS_IRODORI_CFG_SCALE_TEXT=0
HTTP_TTS_IRODORI_CFG_SCALE_CAPTION=0
HTTP_TTS_IRODORI_CFG_SCALE_SPEAKER=0
HTTP_TTS_IRODORI_CHUNKING_ENABLED=false
HTTP_TTS_IRODORI_CHUNK_MIN_CHARS=0
HTTP_TTS_IRODORI_FIRST_SENTENCE_CHUNK_MIN_CHARS=0

# Optional Irodori service startup.
# The Unity app should keep pointing at the Yui backend URL, usually http://127.0.0.1:8000.
# These values are used only by the local service startup scripts.
IRODORI_ENABLE=auto
IRODORI_BASE_URL=
IRODORI_START_COMMAND=
IRODORI_MLX_DIR=
IRODORI_MLX_PYTHON=

# Example for local Irodori / MLX Audio:
# HTTP_TTS_BASE_URL=http://127.0.0.1:41080
# HTTP_TTS_ENDPOINT=/v1/audio/speech
# HTTP_TTS_HEALTH_ENDPOINT=/v1/models
# HTTP_TTS_PROVIDER_ID=irodori
# HTTP_TTS_PAYLOAD_FORMAT=openai_speech
# HTTP_TTS_MODEL=mlx-community/Irodori-TTS-600M-v3-VoiceDesign-8bit
# HTTP_TTS_GENDER=female
# HTTP_TTS_INSTRUCT=若い女性の、明るく可愛いアニメ調の声で話してください。
# HTTP_TTS_LANG_CODE=ja
# HTTP_TTS_FORMAT=wav
# HTTP_TTS_AUDIO_PROCESSOR=soundstretch
# macOS Homebrew example. Leave empty if soundstretch is on PATH.
# HTTP_TTS_SOUNDSTRETCH_PATH=/opt/homebrew/bin/soundstretch
# IRODORI_MLX_DIR=<path-to-Irodori-TTS-Local>
# IRODORI_BASE_URL=http://127.0.0.1:41080

# Example for Irodori-TTS-Server:
# HTTP_TTS_BASE_URL=http://127.0.0.1:8088
# HTTP_TTS_ENDPOINT=/v1/audio/speech
# HTTP_TTS_HEALTH_ENDPOINT=/health
# HTTP_TTS_PROVIDER_ID=irodori-server
# HTTP_TTS_PAYLOAD_FORMAT=irodori_openai_speech
# HTTP_TTS_VOICE=none
# HTTP_TTS_MODEL=irodori-tts
# HTTP_TTS_INSTRUCT=若い女性の、明るく聞き取りやすい声で話してください。
# HTTP_TTS_FORMAT=wav
# HTTP_TTS_AUDIO_PROCESSOR=soundstretch
# HTTP_TTS_IRODORI_NUM_STEPS=24
# HTTP_TTS_IRODORI_SEED=1234
# HTTP_TTS_IRODORI_CHUNKING_ENABLED=false
# HTTP_TTS_IRODORI_CHUNK_MIN_CHARS=120
# Windows Docker or Python example. Keep this empty if starting the server manually.
# IRODORI_START_COMMAND=docker compose -f tools/irodori-server/docker-compose.yml up

# Backend
APP_VERSION=0.1.0-alpha.1
CHARACTER_NAME=Yui
DATABASE_URL=sqlite:///./data/yui.db

# User
DEFAULT_USER_ID=local_user

# Provider selection
CHAT_PROVIDER=openai
VISION_PROVIDER=openai
TTS_PROVIDER=voicevox
TTS_FALLBACK_PROVIDER=voicevox
STT_PROVIDER=openai

# Limits
DAILY_CHAT_LIMIT=300
DAILY_VISION_LIMIT=100
DAILY_STT_MINUTES_LIMIT=60
DAILY_TTS_LIMIT=300
TTS_AUDIO_CACHE_MAX_FILES=300
TTS_AUDIO_CACHE_MAX_MB=256
TTS_AUDIO_CACHE_MAX_AGE_HOURS=24

# Character controls
AVAILABLE_FACES=Neutral,Joy,Fun,Angry,Sorrow,Surprised
AVAILABLE_ANIMATIONS=idle_normal,idle_relaxed,nod_small,nod_big,wave_small,wave_big,thinking,surprised_body,happy_body,troubled_body,proud_pose,tsukkomi_point,look_away,talk_gesture_small
