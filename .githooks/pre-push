#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
PYTHON_BIN="${PYTHON_BIN:-python3}"

"$PYTHON_BIN" "$ROOT/scripts/publication_guard.py" --scope tracked --check-git-metadata --maintainer-mode

if [[ -f "$ROOT/scripts/audit_distribution_release.py" ]]; then
  "$PYTHON_BIN" "$ROOT/scripts/audit_distribution_release.py" --project-root "$ROOT"
fi
